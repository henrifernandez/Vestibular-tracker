# Copie este arquivo para ".env" e preencha com a URL do seu banco Postgres gratuito
# (Neon ou Supabase — veja o README para o passo a passo)
DATABASE_URL="postgresql://usuario:senha@host:5432/banco?sslmode=require"

# Opcional: só necessária para usar o botão "Avaliar com IA" na redação.
# Crie uma chave gratuita (sem cartão) em https://aistudio.google.com/app/apikey
GEMINI_API_KEY="A"

# Opcional: se preenchido, a rota /api/remnote-sync só aceita requisições que
# mandem o mesmo valor no cabeçalho Authorization: Bearer <token>.
# Preencha o mesmo valor no campo "Token de autenticação do Tracker" do plugin do RemNote.
REMNOTE_SYNC_TOKEN=""