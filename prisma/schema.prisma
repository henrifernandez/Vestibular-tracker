// Schema do banco de dados do Monitor de Acertos (vestibular-tracker)
// Provider: PostgreSQL (recomendado: Neon ou Supabase, camada gratuita)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Uma prova/vestibular (ex: ENEM-USP, Unicamp SISU, Unicamp COMVEST, Fuvest, Provão Paulista)
model Prova {
  id          String   @id @default(cuid())
  slug        String   @unique // "enem-usp", "unicamp-sisu", "unicamp-comvest", "fuvest", "provao"
  nome        String
  descricao   String?
  areas       Area[]
  simulados   Simulado[]
  createdAt   DateTime @default(now())
}

// Uma área/prova objetiva dentro de um vestibular (ex: Matemática, Linguagens, Humanas, Natureza, Redação)
model Area {
  id             String       @id @default(cuid())
  provaId        String
  prova          Prova        @relation(fields: [provaId], references: [id], onDelete: Cascade)
  nome           String
  totalQuestoes  Int          // total de questões dessa área na prova (ex: 45, 72, 90)
  ordem          Int          @default(0)
  metas          Meta[]
  resultados     Resultado[]
  conteudosRevisao ConteudoRevisao[]

  @@unique([provaId, nome])
}

// Metas de referência para uma área (pré-carregadas do relatório, mas editáveis)
model Meta {
  id           String   @id @default(cuid())
  areaId       String
  area         Area     @relation(fields: [areaId], references: [id], onDelete: Cascade)
  label        String   // ex: "Meta saudável", "Meta conservadora", "Meta agressiva"
  acertosAlvo  Int?      // meta em número de acertos
  notaAlvo     Float?    // meta em nota estimada (quando aplicável, ex: ENEM)
  observacao   String?
  createdAt    DateTime @default(now())
}

// Um simulado / prova realizada em uma data
model Simulado {
  id          String       @id @default(cuid())
  provaId     String
  prova       Prova        @relation(fields: [provaId], references: [id], onDelete: Cascade)
  data        DateTime
  nome        String?      // ex: "Simulado Poliedro #3"
  observacao  String?
  resultados  Resultado[]
  createdAt   DateTime     @default(now())
}

// Resultado de uma área dentro de um simulado
model Resultado {
  id               String            @id @default(cuid())
  simuladoId       String
  simulado         Simulado          @relation(fields: [simuladoId], references: [id], onDelete: Cascade)
  areaId           String
  area             Area              @relation(fields: [areaId], references: [id], onDelete: Cascade)
  acertos          Int
  totalQuestoes    Int
  notaEstimada     Float?
  textoRedacao     String?           @db.Text
  avaliacaoIA      Json?
  conteudosErrados ConteudoErrado[]
  createdAt        DateTime          @default(now())

  @@unique([simuladoId, areaId])
}

// Conteúdo/assunto específico errado dentro de um resultado (ex: "frações", "funções do 2º grau")
model ConteudoErrado {
  id           String    @id @default(cuid())
  resultadoId  String
  resultado    Resultado @relation(fields: [resultadoId], references: [id], onDelete: Cascade)
  conteudo     String
  createdAt    DateTime  @default(now())
}

// Snapshot de uma sincronização do plugin "Vestibular Tracker Sync" do RemNote.
// Cada sincronização grava uma linha por matéria, então dá pra plotar a evolução
// de cardsFeitos/cardsCorretos ao longo do tempo, além de sempre ter o último valor.
model RevisaoFlashcard {
  id             String    @id @default(cuid())
  materia        String
  cardsFeitos    Int
  cardsCorretos  Int
  ultimaRevisao  DateTime?
  syncedAt       DateTime  @default(now())

  @@index([materia, syncedAt])
}

// Uma linha do cronograma planejado no Notion (databases "biologia", "quimica",
// "fisica-atual" dentro de "Planejamento para estudantes"), sincronizada pelo n8n.
// notionUrl identifica a página de origem no Notion, usado pra fazer upsert
// (evita duplicar a mesma linha a cada sincronização).
model PlanoEstudo {
  id           String   @id @default(cuid())
  notionUrl    String   @unique
  materia      String
  data         DateTime
  diaSemana    String?
  topicos      String?
  feito        Boolean  @default(false)
  observacoes  String?  @db.Text
  syncedAt     DateTime @default(now())
  flashcardsGerados Boolean @default(false)

  @@index([materia, data])
}

// Conteúdo a revisar: cadastrado à mão ou vindo dos ConteudoErrado dos simulados.
// assuntoNorm (minúsculas, sem acento, sem espaços extras) evita duplicata.
// prioridade: ALTA | MEDIA | BAIXA. status: PENDENTE | REVISADO. origem: MANUAL | SIMULADO.
// (strings validadas em lib/revisao.ts, como os demais campos de texto do schema)
model ConteudoRevisao {
  id          String       @id @default(cuid())
  assunto     String
  assuntoNorm String
  disciplina  String       @default("A classificar")
  areaId      String?
  area        Area?        @relation(fields: [areaId], references: [id], onDelete: SetNull)
  prioridade  String       @default("MEDIA")
  status      String       @default("PENDENTE")
  vezesErrado Int          @default(0)
  origem      String       @default("MANUAL")
  observacao  String?      @db.Text
  revisadoEm  DateTime?
  logs        RevisaoLog[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([assuntoNorm, disciplina])
  @@index([status, prioridade])
}

// Uma linha por vez que o conteúdo foi marcado como revisado (histórico).
model RevisaoLog {
  id         String          @id @default(cuid())
  conteudoId String
  conteudo   ConteudoRevisao @relation(fields: [conteudoId], references: [id], onDelete: Cascade)
  revisadoEm DateTime        @default(now())
  confianca  Int?            // 1 a 3

  @@index([conteudoId, revisadoEm])
}
